/* macOS Automation permission prompt. */
"NSAppleEventsUsageDescription" = "__APP_NAME__; Finder'da dosya taşımak, öğeleri Çöp Sepeti'ne göndermek ve Homebrew işlemleri istediğinde Terminal komutları açmak için Otomasyon kullanır. Also used to set Finder folder arrangement rules when you request it.";

/* macOS Screen & System Audio Recording permission prompt. */
"NSAudioCaptureUsageDescription" = "__APP_NAME__, mikserde ses düzeyini ayarlamak ve başlattığın ekran kayıtlarına Mac'in sesini eklemek için her uygulamanın sesini kullanır. Hiçbir şey Mac'inden çıkmaz.";

